{
  "name": "agent-builder",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:dev:api": "pnpm --filter=api-v2 run dev",
    "start:dev:tui": "pnpm --filter=tui run dev",
    "start:dev:web": "pnpm --filter=web run dev",
    "db:dev:push": "pnpm --filter=api-v2 exec npx drizzle-kit push",
    "api:docker:compose": "pnpm --filter=api-v2 exec docker compose -f dev.compose.yml up -d",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
